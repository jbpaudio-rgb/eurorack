  (text "NOTES" (exclude_from_sim no) (at 355.6 40.64 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "98d7bc3f-5cce-40e0-8580-5528dd94ddf9"))
  (text "- Cuve conseillee : Accutronics 4FB3C1B (longue, 3 ressorts, entree 1475 ohms, sortie 2250 ohms, entree isolee / sortie a la masse)." (exclude_from_sim no) (at 355.6 45.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "98df5b48-b04d-45e0-9916-b03e1fc0be89"))
  (text "- Driver : NE5532 en suiveur, 47 ohms -> bobine d'entree (jusqu'a ~7 mA). Recuperation : NE5532 gain x101." (exclude_from_sim no) (at 355.6 50.8 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "f34f30cf-dd5c-43f0-9aa9-8c54eb3efa0e"))
  (text "- TONE : passe-bas variable (22k // 4n7 + pot 100k) ; a fond = brillant, au minimum = sombre (~1,5 kHz)." (exclude_from_sim no) (at 355.6 55.88 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "56e6fb2c-7b16-4398-aedb-e63d23fb3f83"))
  (text "- MIX : la paire PNP BCM857DS partage ~200 uA entre les deux OTA du LM13700 (sec / humide) ; MIX + MIX CV (attenuateur) pilotent les bases." (exclude_from_sim no) (at 355.6 60.96 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "7b7f12bd-3a10-44e6-9315-744aa083f4bf"))
  (text "- SEND = signal qui attaque la cuve ; RETURN remplace le retour de la cuve (normalise dessus) -> boucle d'effet." (exclude_from_sim no) (at 355.6 66.04 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "81214189-4488-4d76-a0b7-60499888bab9"))
  (text "- La cuve se fixe dans le boitier (pas sur le module) ; deux cables blindes RCA -> JST PH." (exclude_from_sim no) (at 355.6 71.12 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "8b569567-0b09-430a-8fc8-d1b72d37a783"))
  (text "- -12V = bande rouge du cable." (exclude_from_sim no) (at 355.6 76.2 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "86d2c229-b38c-496a-a863-7d5c9907986c"))
