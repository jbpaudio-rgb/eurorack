  (label "-12V" (at 1122.68 182.88 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8066fd78-d09b-4ff2-990f-c48ce726f9d2"))
  (text "NOTES" (exclude_from_sim no) (at 1193.8 40.64 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "f98d2782-bd9e-410c-9d10-acfe2af9d925"))
  (text "- Architecture inspiree du Buchla 259 (circuit original Octavio) : osc. de modulation, section MOD, osc. principal, HARMONICS." (exclude_from_sim no) (at 1193.8 45.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "3a08e45b-d208-429b-bea7-82603377795d"))
  (text "- Deux coeurs dent de scie facon 921 ; 0 V = 440 Hz (R 549k) ; FREQUENCY +/-4 V = 8 octaves (27 Hz a 7 kHz), FINE +/- une quinte, LFO = -7 octaves." (exclude_from_sim no) (at 1193.8 50.8 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "bdd488b8-03cf-40b5-994f-2b2f51f33ff1"))
  (text "- MOD INDEX : attenuverter sur le signal de modulation + OTA pour INDEX CV ; AMPL / PITCH / TIMBRE (haut = ON) envoient MIN vers l'AM, le convertisseur expo (200k) et la commande de timbre." (exclude_from_sim no) (at 1193.8 55.88 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "83aee143-fccd-41cd-9739-9ae20194cbc1"))
  (text "- PHASE LOCK : entree couplee en alternatif injectee dans la reference de remise a zero du coeur principal (verrouillage par injection)." (exclude_from_sim no) (at 1193.8 60.96 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "8e8b6279-946d-42f3-abd2-4b85462bd9d8"))
  (text "- HARMONICS : replieur (OTA x1..x4 + seuils 2,6 V / 7,8 V, DC de SYMMETRY), forme M (repli doux a 2,5 V), dent de scie du coeur." (exclude_from_sim no) (at 1193.8 66.04 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "10ac7cd3-321e-418a-a3ba-62115a29078b"))
  (text "- X = SAW -> M (SYMMETRY), Y = SINE -> X (TIMBRE), FINAL = REPLIE -> Y (ORDER), puis AM (OTA)." (exclude_from_sim no) (at 1193.8 71.12 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "71fb19c5-f10e-4e68-9347-d2332c02bf84"))
  (text "- -12V = bande rouge du cable." (exclude_from_sim no) (at 1193.8 76.2 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "66366ea1-454a-48d4-9b46-c2064aa0ef2d"))
