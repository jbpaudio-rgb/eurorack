  (text "- Deux coeurs dent de scie facon 921 (comme notre VCO) : MOD (oscillateur de modulation) et C (oscillateur complexe)." (exclude_from_sim no) (at 889 45.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "5712b915-9db6-496c-a2a2-ed09c4a77ab0"))
  (text "- MOD : FREQUENCY +/-3,4 oct, RANGE HI/LO (-6 oct), MOD CV 1 V/oct ; WAVE : SAW / carre (centre) / TRI ; INDEX = OTA ; FM/AM aiguille MI." (exclude_from_sim no) (at 889 50.8 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "b174cf64-f9cf-495d-9300-d3050f44384a"))
  (text "- COMPLEX : PITCH +/-3,4 oct autour de 262 Hz, 1V/OCT 0,1 %, FM depuis l'INDEX ; sinus par paire differentielle." (exclude_from_sim no) (at 889 55.88 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "a7b60b57-5033-41bd-a10e-8a37f4ca2e32"))
  (text "- TIMBRE : X = -(S/2)(1+3t) par OTA, puis repliement a 2,6 V et 7,8 V (redresseurs de precision), sortie FOLDO +/-5 V." (exclude_from_sim no) (at 889 60.96 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "6ada9308-6f06-4a0d-a20c-3fd8fb7076a2"))
  (text "- WAVESHAPE : OUT = FOLD + s (cible - FOLD), cible = SPIKE / carre (centre) / TRIANGLE ; AM : gain 1 + 0,4 AMI (OTA)." (exclude_from_sim no) (at 889 66.04 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "d29793e5-b050-41d9-903d-9c2b19ec3696"))
  (text "- OTA : Iabc = commande / R1, R2 = R1/9 vers -12 V annule la tension de la broche Iabc (zero a 0 V)." (exclude_from_sim no) (at 889 71.12 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "2c125dca-6667-484a-a9f7-3f906716ecca"))
