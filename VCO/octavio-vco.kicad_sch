  (text "NOTES" (exclude_from_sim no) (at 431.8 40.64 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "78d8e7d4-775e-40df-a52b-377d9e106de8"))
  (text "- RANGE (SW2) : LO, 32', 16', 8', 4', 2' = -7, -2, -1, 0, +1, +2 octaves (echelle 0,1 %, tampon U2D). FREQUENCY = +/- 6 demi-tons." (exclude_from_sim no) (at 431.8 45.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "60dfb1e3-2850-41c0-a215-78da88d7bea9"))
  (text "- Coeur dent de scie facon 921 : convertisseur expo (Q1, U1A/U1B) -> integrateur U1C (C10 10 nF) -> remise a zero par JFET Q2 quand la rampe atteint 5 V (U1D)." (exclude_from_sim no) (at 431.8 50.8 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "1572f909-7896-48a5-82e5-eccb4478e274"))
  (text "- 1V/OCT : R5 100k 0,1 %, R9 1k +3300 ppm colle a Q1, reglage RV7 ; aigus : RV8 en serie avec C10." (exclude_from_sim no) (at 431.8 55.88 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "0cbb7fe5-7d3f-4b54-8501-96a8af7d90b2"))
  (text "- Formes : SAW (U2A), TRIANGLE (redresseur double alternance U2B/U2C), SINE (paire Q3 + U3A, symetrie RV9), PULSE (U3B, largeur U3C)." (exclude_from_sim no) (at 431.8 60.96 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "b96348f4-fce7-4778-9a10-55211712390b"))
  (text "- SYNC : front montant -> impulsion sur la grille de Q2 (synchro dure)." (exclude_from_sim no) (at 431.8 66.04 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "dd15e78c-4c2a-4076-ba82-2bf627ecee0b"))
