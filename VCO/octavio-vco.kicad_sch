  (text "NOTES" (exclude_from_sim no) (at 431.8 40.64 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "70b2c48e-bcdd-415b-a8cb-2c86cfef7db2"))
  (text "- Coeur dent de scie facon 921 : convertisseur expo (Q1, U1A/U1B) -> integrateur U1C (C10 10 nF) -> remise a zero par JFET Q2 quand la rampe atteint 5 V (U1D)." (exclude_from_sim no) (at 431.8 45.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "1b34f751-50af-4082-9c5b-764dd44868fd"))
  (text "- 1V/OCT : R5 100k 0,1 %, R9 1k +3300 ppm colle a Q1, reglage RV7 ; aigus : RV8 en serie avec C10." (exclude_from_sim no) (at 431.8 50.8 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "d59273dc-f2b7-4b5e-8101-483cd9539184"))
  (text "- Formes : SAW (U2A), TRIANGLE (redresseur double alternance U2B/U2C), SINE (paire Q3 + U3A, symetrie RV9), PULSE (U3B, largeur U3C)." (exclude_from_sim no) (at 431.8 55.88 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "222cada6-bdaa-4663-ad7e-c6330b98e2aa"))
  (text "- SYNC : front montant -> impulsion sur la grille de Q2 (synchro dure)." (exclude_from_sim no) (at 431.8 60.96 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "ae0c6752-d5c1-4bec-b2d6-ef5cebd36439"))
  (text "- -12V = bande rouge du cable." (exclude_from_sim no) (at 431.8 66.04 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "ec22fdb9-82ac-4757-82a4-dd621eb29eea"))
