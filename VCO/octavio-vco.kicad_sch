  (text "NOTES" (exclude_from_sim no) (at 660.4 40.64 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "fe7e9816-2b05-4383-be30-a7d68579b3d8"))
  (text "- RANGE (SW2, mini SR16 1P8T, butee sur 6) : LO, 32', 16', 8', 4', 2' = -7, -2, -1, 0, +1, +2 octaves (echelle 0,1 %, tampon U2D). FREQUENCY = +/- 6 demi-tons." (exclude_from_sim no) (at 660.4 45.72 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "76c7d873-b644-48e5-91c3-eb0572de111e"))
  (text "- Coeur dent de scie facon 921 : convertisseur expo (Q1, U1A/U1B) -> integrateur U1C (C10 10 nF) -> remise a zero par JFET Q2 quand la rampe atteint 5 V (U1D)." (exclude_from_sim no) (at 660.4 50.8 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "c10294bb-4e7d-4ce5-8f7f-0552a1de037d"))
  (text "- 1V/OCT : R5 100k 0,1 %, R9 1k +3300 ppm colle a Q1, reglage RV7 ; aigus : RV8 en serie avec C10." (exclude_from_sim no) (at 660.4 55.88 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "65ed29b5-86d1-4d58-87c1-c2adcd9317bc"))
  (text "- Formes : SAW (U2A), TRIANGLE (redresseur double alternance U2B/U2C), SINE (paire Q3 + U3A, symetrie RV9), PULSE (U3B, largeur U3C)." (exclude_from_sim no) (at 660.4 60.96 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "a16cf83c-d559-40a9-881a-65d8084ffdb8"))
  (text "- BLEND : SINE -> TRIANGLE -> SAW -> PULSE en continu (differences U4, 3 OTA U6/U7, commandes U5 avec zeners de butee)." (exclude_from_sim no) (at 660.4 66.04 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "d0567719-e048-4512-9cfd-27ff9a80bb6a"))
  (text "- SYNC : front montant -> impulsion sur la grille de Q2 (synchro dure)." (exclude_from_sim no) (at 660.4 71.12 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "cc11c340-4e93-4524-8017-3d12bd1da853"))
  (text "- -12V = bande rouge du cable." (exclude_from_sim no) (at 660.4 76.2 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "cc719d81-5bfb-40dc-b949-9a78836afb37"))
